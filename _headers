# Keep the *.pages.dev address out of search results; only the custom domain is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Images are not hashed; a replaced file keeps its URL, so cache for a week and rename on replace.
/img/*
  Cache-Control: public, max-age=604800
